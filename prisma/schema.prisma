generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
  AGENT
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  OPEN
  PROCESSING
  SUCCESS
  LOST
}

enum BookingType {
  FLIGHT
  HOTEL
  UMRAH
  VISA
  TOUR
}

enum BookingChannel {
  CHECKOUT
  SERVICE_REQUEST
  CHATBOT
}

enum SearchProvider {
  SABRE
  AMADEUS
  INTERNAL
}

enum DestinationScope {
  DOMESTIC
  INTERNATIONAL
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String?
  emailVerifiedAt DateTime?
  phone          String?
  role           Role            @default(CUSTOMER)
  bookings       Booking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  bookingEvents           BookingEvent[]
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UmrahPackage {
  id                String           @id @default(cuid())
  slug              String           @unique
  title             String
  subtitle          String?
  description       String           @db.Text
  makkahNights      Int
  madinahNights     Int
  departureCity     String
  airlineNotes      String?
  hotelSummary      String?
  inclusions        Json
  exclusions        Json
  basePrice         Decimal          @db.Decimal(10, 2)
  currency          String           @default("SAR")
  seatsAvailable    Int              @default(0)
  startDate         DateTime
  endDate           DateTime
  status            PackageStatus    @default(DRAFT)
  seoTitle          String
  seoDescription    String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model FlightSearchLog {
  id              String         @id @default(cuid())
  origin          String
  destination     String
  departureDate   DateTime
  returnDate      DateTime?
  adults          Int            @default(1)
  children        Int            @default(0)
  infants         Int            @default(0)
  cabinClass      String?
  provider        SearchProvider
  requestPayload  Json
  responsePayload Json?
  searchedAt      DateTime       @default(now())

  /// Trending searches read recent rows; the retention sweep deletes old ones.
  @@index([searchedAt])
}

// Every customer request: checkout bookings, service request forms and chatbot leads.
model Booking {
  id             String          @id @default(cuid())
  reference      String          @unique
  type           BookingType
  channel        BookingChannel  @default(CHECKOUT)
  status         BookingStatus   @default(OPEN)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  title          String?
  provider       SearchProvider?
  providerRecord String?
  totalAmount    Decimal?        @db.Decimal(10, 2)
  currency       String          @default("PKR")
  payload        Json
  paymentData    Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         BookingEvent[]

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Destination {
  id          String   @id @default(cuid())
  slug        String?  @unique
  city        String
  country     String
  scope       DestinationScope @default(INTERNATIONAL)
  tagline     String?
  overview    String?  @db.Text
  highlights  Json?
  travelTips  Json?
  /// [{ question, answer }] shown on the page and as FAQPage structured data.
  faqs        Json     @default("[]")
  bestTimeToVisit String?
  idealStay   String?
  currency    String?
  timezone    String?
  language    String?
  iataCode    String?
  imageUrl    String?  @db.Text
  fare        String
  notes       String?
  gradient    String   @default("blue")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  seoTitle    String
  seoDescription String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activities  Activity[]
}

model Activity {
  id             String   @id @default(cuid())
  slug           String?  @unique
  destinationId  String
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  title          String
  category       String   @default("tourist-attraction")
  description    String   @db.Text
  imageUrl       String
  cost           String
  /// Key facts shown at the top of the detail page (hidden when empty).
  duration           String?
  openingHours       String?
  location           String?
  bestTimeToVisit    String?
  /// string[]: short selling points.
  highlights         Json     @default("[]")
  /// string[]: what the ticket/tour price covers and what it doesn't.
  included           Json     @default("[]")
  excluded           Json     @default("[]")
  /// string[]: ordered "what to expect" steps.
  itinerary          Json     @default("[]")
  /// string[]: "know before you go" notes (dress code, closures, ID).
  importantInfo      Json     @default("[]")
  cancellationPolicy String?  @db.Text
  /// [{ question, answer }] shown on the page and as FAQPage structured data.
  faqs               Json     @default("[]")
  reviews        Float    @default(0)
  reviewCount    Int      @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([destinationId])
}

model TourPackage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  destination    String
  tourType       String   @default("cultural")
  duration       Int
  description    String   @db.Text
  highlights     Json
  imageUrl       String   @db.Text
  pricePerAdult  Decimal  @db.Decimal(10, 2)
  pricePerChild  Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String     @db.Text
  content        String     @db.Text
  coverImageUrl  String
  author         String     @default("AIM Digital")
  category       String     @default("travel")
  tags           Json       @default("[]")
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model JobOpening {
  id             String   @id @default(cuid())
  title          String
  team           String
  location       String
  employmentType String
  summary        String   @db.Text
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// City-pair landing page, e.g. /flights/lahore-to-jeddah. Content is written
/// and verified in /admin/flight-routes; schedules change, so routes start as
/// drafts (isActive = false) until an admin has checked the airline list.
model FlightRoute {
  id                 String   @id @default(cuid())
  slug               String   @unique
  originCity         String
  originIata         String
  originAirport      String
  destinationCity    String
  destinationCountry String
  destinationIata    String
  destinationAirport String
  /// Paragraphs separated by a blank line.
  intro              String   @db.Text
  flightTime         String
  distance           String
  /// [{ name, code, service }] e.g. { "Saudia", "SV", "Non-stop" }
  airlines           Json     @default("[]")
  /// string[]
  travelTips         Json     @default("[]")
  /// string[]
  documents          Json     @default("[]")
  /// [{ question, answer }]
  faqs               Json     @default("[]")
  /// Admin-entered indicative fare, e.g. "PKR 95,000". Shown only when set.
  fareFrom           String?
  isActive           Boolean  @default(false)
  sortOrder          Int      @default(0)
  seoTitle           String
  seoDescription     String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([originIata, destinationIata])
  @@index([isActive, sortOrder])
}

model AirlinePartner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String
  // R2 object key; null for logos bundled in /public/airlines.
  storagePath String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerReview {
  id           String   @id @default(cuid())
  customerName String
  location     String?
  rating       Int      @default(5)
  title        String
  body         String   @db.Text
  tripType     String?
  isVerified   Boolean  @default(false)
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  city       String
  address    String   @db.Text
  phone      String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
/// Request counters for rate-limited public endpoints (src/lib/rate-limit-store.ts).
/// Shared by every app process; rows expire and are swept automatically.
model RateLimitBucket {
  /// "<rule id>:<sha256 of client IP>"
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Append-only history of a booking: every status change and who made it.
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  note       String?
  /// The admin who made the change; kept as a name too in case the account is deleted.
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  createdAt  DateTime       @default(now())

  @@index([bookingId, createdAt])
}
