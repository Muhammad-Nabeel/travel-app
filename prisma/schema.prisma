generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
  AGENT
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum BookingType {
  FLIGHT
  HOTEL
  UMRAH
  VISA
  TOUR
}

enum BookingChannel {
  CHECKOUT
  SERVICE_REQUEST
  CHATBOT
}

enum SearchProvider {
  SABRE
  AMADEUS
  INTERNAL
}

enum DestinationScope {
  DOMESTIC
  INTERNATIONAL
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String?
  emailVerifiedAt DateTime?
  phone          String?
  role           Role            @default(CUSTOMER)
  bookings       Booking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UmrahPackage {
  id                String           @id @default(cuid())
  slug              String           @unique
  title             String
  subtitle          String?
  description       String           @db.Text
  makkahNights      Int
  madinahNights     Int
  departureCity     String
  airlineNotes      String?
  hotelSummary      String?
  inclusions        Json
  exclusions        Json
  basePrice         Decimal          @db.Decimal(10, 2)
  currency          String           @default("SAR")
  seatsAvailable    Int              @default(0)
  startDate         DateTime
  endDate           DateTime
  status            PackageStatus    @default(DRAFT)
  seoTitle          String
  seoDescription    String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model FlightSearchLog {
  id              String         @id @default(cuid())
  origin          String
  destination     String
  departureDate   DateTime
  returnDate      DateTime?
  adults          Int            @default(1)
  children        Int            @default(0)
  infants         Int            @default(0)
  cabinClass      String?
  provider        SearchProvider
  requestPayload  Json
  responsePayload Json?
  searchedAt      DateTime       @default(now())
}

// Every customer request: checkout bookings, service request forms and chatbot leads.
model Booking {
  id             String          @id @default(cuid())
  reference      String          @unique
  type           BookingType
  channel        BookingChannel  @default(CHECKOUT)
  status         BookingStatus   @default(PENDING)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String?
  customerEmail  String?
  customerPhone  String?
  title          String?
  provider       SearchProvider?
  providerRecord String?
  totalAmount    Decimal?        @db.Decimal(10, 2)
  currency       String          @default("PKR")
  payload        Json
  paymentData    Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Destination {
  id          String   @id @default(cuid())
  slug        String?  @unique
  city        String
  country     String
  scope       DestinationScope @default(INTERNATIONAL)
  tagline     String?
  overview    String?  @db.Text
  highlights  Json?
  travelTips  Json?
  bestTimeToVisit String?
  idealStay   String?
  currency    String?
  timezone    String?
  language    String?
  iataCode    String?
  imageUrl    String?  @db.Text
  fare        String
  notes       String?
  gradient    String   @default("blue")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  seoTitle    String
  seoDescription String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activities  Activity[]
}

model Activity {
  id             String   @id @default(cuid())
  slug           String?  @unique
  destinationId  String
  destination    Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  title          String
  category       String   @default("tourist-attraction")
  description    String?  @db.Text
  imageUrl       String
  cost           String
  reviews        Float    @default(4.5)
  reviewCount    Int      @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([destinationId])
}

model TourPackage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  destination    String
  tourType       String   @default("cultural")
  duration       Int
  description    String   @db.Text
  highlights     Json
  imageUrl       String   @db.Text
  pricePerAdult  Decimal  @db.Decimal(10, 2)
  pricePerChild  Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD")
  rating         Float    @default(4.5)
  reviewCount    Int      @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String     @db.Text
  content        String     @db.Text
  coverImageUrl  String
  author         String     @default("AIM Digital")
  category       String     @default("travel")
  tags           Json       @default("[]")
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model JobOpening {
  id             String   @id @default(cuid())
  title          String
  team           String
  location       String
  employmentType String
  summary        String   @db.Text
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerReview {
  id           String   @id @default(cuid())
  customerName String
  location     String?
  rating       Int      @default(5)
  title        String
  body         String   @db.Text
  tripType     String?
  isVerified   Boolean  @default(false)
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  city       String
  address    String   @db.Text
  phone      String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}