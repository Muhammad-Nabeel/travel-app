generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
  AGENT
}

enum PackageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum SearchProvider {
  SABRE
  AMADEUS
  INTERNAL
}

enum DestinationScope {
  DOMESTIC
  INTERNATIONAL
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String?
  emailVerifiedAt DateTime?
  phone          String?
  role           Role            @default(CUSTOMER)
  bookings       Booking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  packageOrders  PackageBooking[]
  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UmrahPackage {
  id                String           @id @default(cuid())
  slug              String           @unique
  title             String
  subtitle          String?
  description       String           @db.Text
  makkahNights      Int
  madinahNights     Int
  departureCity     String
  airlineNotes      String?
  hotelSummary      String?
  inclusions        Json
  exclusions        Json
  basePrice         Decimal          @db.Decimal(10, 2)
  currency          String           @default("SAR")
  seatsAvailable    Int              @default(0)
  startDate         DateTime
  endDate           DateTime
  status            PackageStatus    @default(DRAFT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  packageBookings   PackageBooking[]
}

model FlightSearchLog {
  id              String         @id @default(cuid())
  origin          String
  destination     String
  departureDate   DateTime
  returnDate      DateTime?
  adults          Int            @default(1)
  children        Int            @default(0)
  infants         Int            @default(0)
  cabinClass      String?
  provider        SearchProvider
  requestPayload  Json
  responsePayload Json?
  searchedAt      DateTime       @default(now())
}

model HotelSearchLog {
  id              String         @id @default(cuid())
  cityCode        String
  checkInDate     DateTime
  checkOutDate    DateTime
  guests          Int            @default(1)
  rooms           Int            @default(1)
  provider        SearchProvider
  requestPayload  Json
  responsePayload Json?
  searchedAt      DateTime       @default(now())
}

model Booking {
  id               String          @id @default(cuid())
  reference        String          @unique
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  status           BookingStatus   @default(PENDING)
  provider         SearchProvider
  providerRecord   String?
  totalAmount      Decimal         @db.Decimal(10, 2)
  currency         String          @default("SAR")
  flightData       Json?
  hotelData        Json?
  paymentData      Json?
  isChatbotRequest Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Destination {
  id          String   @id @default(cuid())
  slug        String?  @unique
  city        String
  country     String
  scope       DestinationScope @default(INTERNATIONAL)
  tagline     String?
  overview    String?  @db.Text
  highlights  Json?
  travelTips  Json?
  bestTimeToVisit String?
  idealStay   String?
  currency    String?
  timezone    String?
  language    String?
  iataCode    String?
  imageUrl    String?  @db.Text
  fare        String
  notes       String?
  gradient    String   @default("blue")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id             String   @id @default(cuid())
  destinationId  String
  title          String
  category       String   @default("tourist-attraction")
  description    String?  @db.Text
  imageUrl       String
  cost           String
  reviews        Float    @default(4.5)
  reviewCount    Int      @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PackageBooking {
  id             String         @id @default(cuid())
  packageId      String
  package        UmrahPackage   @relation(fields: [packageId], references: [id])
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  travelers      Int            @default(1)
  status         BookingStatus  @default(PENDING)
  totalAmount    Decimal        @db.Decimal(10, 2)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model TourPackage {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  subtitle       String?
  destination    String
  country        String
  description    String        @db.Text
  durationDays   Int
  departureCity  String
  highlights     Json          @default("[]")
  inclusions     Json
  exclusions     Json
  basePrice      Decimal       @db.Decimal(10, 2)
  currency       String        @default("PKR")
  seatsAvailable Int           @default(0)
  imageUrl       String?
  status         PackageStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String     @db.Text
  content        String     @db.Text
  coverImageUrl  String
  author         String     @default("AIM Digital")
  category       String     @default("travel")
  tags           Json       @default("[]")
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerReview {
  id           String   @id @default(cuid())
  customerName String
  location     String?
  rating       Int      @default(5)
  title        String
  body         String   @db.Text
  tripType     String?
  isVerified   Boolean  @default(false)
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PaymentSetting {
  id                   String   @id @default(cuid())
  serviceChargePercent Decimal  @default(0) @db.Decimal(5, 2)
  enableWise           Boolean  @default(true)
  enableStripe         Boolean  @default(true)
  enablePaypal         Boolean  @default(true)
  enableSumup          Boolean  @default(true)
  enablePaymob         Boolean  @default(true)
  enableCashOnDelivery Boolean  @default(true)
  enablePayAtBranch    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  city       String
  address    String   @db.Text
  phone      String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}