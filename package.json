{
  "name": "travel-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "prisma generate && next build",
    "start": "next start --port 3004",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:restart": "npm run docker:down && npm run docker:up",
    "docker:logs": "docker compose logs --tail 50 -f",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "node -e \"if (process.env.DATABASE_URL || process.env.DIRECT_URL) { require('child_process').execSync('prisma generate', { stdio: 'inherit' }) }\"",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:admin": "node prisma/seed.js --admin-only",
    "package:webhostmost": "bash scripts/package-webhostmost.sh",
    "package:webhostmost:npm": "bash scripts/package-webhostmost-npm.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/lib-storage": "^3.1030.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.19",
    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.3",
    "next-auth": "^4.24.13",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
